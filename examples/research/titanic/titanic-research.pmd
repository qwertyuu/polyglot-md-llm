```python {#test_features role=test test-of=prepare}
import pandas as pd

train = pd.read_csv(outputs.path("prepare", "train-features.csv"))
test = pd.read_csv(outputs.path("prepare", "test-features.csv"))
assert len(train) == ctx.train_rows and len(test) == ctx.test_rows
assert {"Title", "FamilySize", "IsAlone", "FarePerPerson"}.issubset(test.columns)
assert list(train.drop(columns="Survived").columns) == list(test.columns)
```

```python {#test_models role=test test-of=compare}
import pandas as pd

scores = pd.read_csv(outputs.path("compare", "model-scores.csv"))
assert len(scores) == 3
assert scores["cv_accuracy_mean"].between(0.75, 0.90).all()
assert scores["cv_roc_auc_mean"].between(0.78, 0.92).all()
assert ctx.best_cv_accuracy >= 0.80
assert outputs.path("compare", "model-comparison.png").read_bytes().startswith(b"\x89PNG")
```

```python {#test_submission role=test test-of=final_fit}
import json
import pickle

import pandas as pd

submission = pd.read_csv(outputs.path("final_fit", "submission.csv"))
manifest = json.loads(outputs.path("final_fit", "run-manifest.json").read_text(encoding="utf-8"))
model = pickle.loads(outputs.path("final_fit", "model.pkl").read_bytes())
assert list(submission.columns) == ["PassengerId", "Survived"]
assert len(submission) == 418 and submission["PassengerId"].is_unique
assert set(submission["Survived"].unique()).issubset({0, 1})
assert 0.25 < submission["Survived"].mean() < 0.55
assert manifest["prediction_rows"] == len(submission)
assert hasattr(model, "predict")
```

## Conclusion

The useful result is not only a score. The notebook records exactly which
inputs produced the audit, figures, engineered tables, model comparison,
serialized pipeline, and submission; each claim above is connected to an
executable cell or test.
